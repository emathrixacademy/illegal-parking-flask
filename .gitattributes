# Shell scripts and service units run on the Pi (Linux). If Git checks them out
# with CRLF on a Windows machine and they are copied over by scp/USB, bash fails
# with "$'\r': command not found" — so pin them to LF regardless of platform.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
Procfile text eol=lf
